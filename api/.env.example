# Brewing API — environment

ENVIRONMENT=development
API_PORT=8000

# Persistence — local dev defaults to SQLite; use Postgres (Neon) in prod.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB
DATABASE_URL=sqlite:///./brewing.db

# Session validation — MUST match the secret web uses to sign sessions.
SESSION_SECRET=dev-insecure-change-me
SESSION_ALGORITHM=HS256

# CORS — the web origin allowed to call this API.
WEB_ORIGIN=http://localhost:3000

# Coordination Copilot + execution orchestration (Anthropic).
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-opus-4-7
ORCHESTRATION_PACEMAKER_SECONDS=3.5

# Settlement provider (provider-agnostic domain). "circle" = custodial DCW;
# "noncustodial" = tenant-key-controlled escrow on Solana (Brewing never holds
# the keys; release/slash are authorized by the tenant's controller wallet).
SETTLEMENT_PROVIDER=circle

# Circle Developer-Controlled Wallets — USDC on Solana devnet.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_BLOCKCHAIN=SOL-DEVNET

# USDC SPL mint for the active chain. Only the non-custodial provider needs it
# (to read tenant-wallet balances directly). Devnet USDC by default; set the
# mainnet USDC mint (EPjFWdd5...) when CIRCLE_BLOCKCHAIN=SOL.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
