# Brewing API — PRODUCTION environment template.
# Copy these into your backend host's env settings (Railway/Render/Fly).
# Do NOT commit the filled-in version.

ENVIRONMENT=production

# Managed Postgres (e.g. Neon). The +psycopg driver is already in requirements.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require

# MUST be identical to the web app's SESSION_SECRET (used for the /auth/session handshake).
SESSION_SECRET=generate-a-long-random-string
SESSION_ALGORITHM=HS256

# The deployed frontend origin, for CORS. No trailing slash.
WEB_ORIGIN=https://your-frontend-domain.vercel.app

# Coordination Copilot + orchestration.
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-opus-4-7
ORCHESTRATION_PACEMAKER_SECONDS=3.5

# Settlement.
SETTLEMENT_PROVIDER=circle
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_BLOCKCHAIN=SOL-DEVNET
